[m[32m+        };
[m[32m+        // An override is matched against the *derived* entries only, and by the
[m[32m+        // file each one resolves to rather than by the string written: a profile
[m[32m+        // may name the folder or the `cartridge.json` inside it, and `Entry::file`
[m[32m+        // is the one rule that already makes those the same cartridge. The
[m[32m+        // derived count is frozen before the `retain`, so two profile entries
[m[32m+        // naming one path are two instances of it and do not eat each other.
[m[32m+        let named: Vec<PathBuf> = overrides.iter().map(|e| e.file(&self.dir)).collect();
