{
  "name": "auth",
  "entry": "init.lua",
  "description": "Reads any provider's secrets from its own pass store, lists them by name without values, and makes the authenticated calls itself (GPT Live connections and JEV questions) without returning secrets to consumers.",
  "events": {
    "auth": {
      "description": "Secrets by name, never by value: {op:\"status\", provider, field?} -> state, source and checked stores for one entry (field defaults to api-key); {op:\"list\"} -> every stored entry as {name, provider, field, available}.",
      "schema": {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "status",
              "list"
            ]
          },
          "provider": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        }
      }
    },
    "auth.live": {
      "description": "A GPT Live session on the discovered credential: create {request} on the WebRTC transport (an SDP offer) or the WebSocket transport (`{type:\"websocket\"}`, which also carries audio), attach {session_id}, send {session_id, event}, close {session_id}.",
      "schema": {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "create",
              "attach",
              "send",
              "close"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "request": {
            "type": "object"
          },
          "event": {
            "type": "object"
          }
        }
      }
    },
    "auth.live.event": {
      "description": "An event of an attached session: {session_id, event}; auth.attached, auth.detached and auth.failed report transport state, every other event carries the OpenAI payload.",
      "schema": {
        "type": "object",
        "required": [
          "session_id",
          "event"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "event": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "auth.jev": {
      "description": "A JEV judgement on the stored TypeSafe key: {state, questions, model?} -> {answers, usage} as the API returns them; questions and answers are maps keyed by the caller's ids. The caller supplies no key and no destination.",
      "timeout_ms": 20000,
      "schema": {
        "type": "object",
        "required": [
          "state",
          "questions"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": [
              "string",
              "object",
              "array"
            ]
          },
          "questions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "type",
                "instructions"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "noul",
                    "choice",
                    "score"
                  ]
                }
              }
            }
          },
          "model": {
            "type": "string"
          }
        }
      }
    }
  },
  "settings": {
    "credentials_dir": {
      "type": "string",
      "default": null,
      "optional": true,
      "doc": "Directory holding `credentials.json`. Absent leaves the configured credential unused."
    },
    "router_data_dir": {
      "type": "string",
      "default": null,
      "optional": true,
      "doc": "Directory holding the router's `auth.json`, read for an already-authorized route."
    },
    "codex_home": {
      "type": "string",
      "default": null,
      "optional": true,
      "doc": "Codex home directory, when it is not the default."
    }
  },
  "commands": {
    "build": {
      "argv": [
        "bun",
        "install",
        "--frozen-lockfile"
      ],
      "cwd": "."
    },
    "check": {
      "argv": [
        "bun",
        "run",
        "check"
      ],
      "cwd": "."
    },
    "test": {
      "argv": [
        "bun",
        "test"
      ],
      "cwd": "."
    }
  },
  "grant": {
    "exec": [
      "bun",
      "gpg"
    ],
    "read": [
      "/"
    ],
    "write": [
      "$HOME/.cartridge/auth/.gnupg"
    ],
    "net": [
      "api.openai.com",
      "api.typesafe.ai"
    ]
  },
  "listen": [
    "auth",
    "auth.live",
    "auth.jev"
  ]
}
