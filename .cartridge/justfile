set positional-arguments
runtime_root := if path_exists(justfile_directory() / "cartridge.ctg/Cargo.toml") == "true" { justfile_directory() / "cartridge.ctg" } else { justfile_directory() }
memo_runner := runtime_root / ".cartridge/tools/memo-run"
development := runtime_root / ".cartridge/memos/routine/cartridge-development.md"

help:
    @just --list

build target="all" *args:
    @"{{memo_runner}}" "{{development}}" build "$@"

check target="all" *args:
    @"{{memo_runner}}" "{{development}}" check "$@"

test target="all" *args:
    @"{{memo_runner}}" "{{development}}" test "$@"

links:
    @"{{memo_runner}}" "{{development}}" links

run *args:
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" run "$@"

modules:
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" modules

describe module:
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" describe "$@"

daemon profile="default":
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" daemon "$@"

process module *args:
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" process "$@"

invoke service payload="null" profile="default":
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" invoke "$@"

call service payload="null" profile="default":
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" call "$@"

status profile="default":
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" status "$@"

tail profile="default":
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" tail "$@"

ledger:
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" ledger

mcp:
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" mcp

proxy port="4242":
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-proxy.md" serve "$@"

launch agent *args:
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" launch "$@"

verify module="":
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" verify "$@"

smoke target="all":
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-smoke.md" test "$@"

live:
    @"{{memo_runner}}" "{{runtime_root}}/.cartridge/memos/routine/cartridge-runtime.md" live
