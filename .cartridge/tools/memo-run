#!/bin/sh
# Run the just recipes in an explicitly selected, trusted local routine memo.
set -eu
if [ "$#" -lt 1 ]; then
    echo 'usage: memo-run <routine.md> [recipe [args...]]' >&2
    exit 2
fi
memo_file=$(realpath "$1")
shift
case "$memo_file" in
    */.cartridge/memos/*.md|*/.cartridge/development/memos/*.md) ;;
    *) echo 'memo-run: expected a Markdown memo inside .cartridge/memos' >&2; exit 2 ;;
esac
MEMO_OWNER_ROOT=${memo_file%/.cartridge/*}
MEMO_FILE=$memo_file
MEMO_JUSTFILE=$(mktemp "${TMPDIR:-/tmp}/cartridge-memo.XXXXXX")
export MEMO_OWNER_ROOT MEMO_FILE MEMO_JUSTFILE
trap 'rm -f "$MEMO_JUSTFILE"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
awk '
    /^```just[[:space:]]*$/ { blocks++; inside=1; next }
    /^```[[:space:]]*$/ && inside { inside=0; next }
    inside { print }
    END { if (blocks != 1 || inside) exit 2 }
' "$memo_file" > "$MEMO_JUSTFILE" || {
    echo 'memo-run: expected exactly one closed just block' >&2
    exit 2
}
just --justfile "$MEMO_JUSTFILE" --working-directory "$MEMO_OWNER_ROOT" "$@"
