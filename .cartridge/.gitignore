# Whitelist: a fresh checkout gets only what is listed here. Everything else
# written into .cartridge by a run (sockets, stores, logs) stays on this
# machine.
/*
!/.gitignore
!/README.md
!/config.lua
!/help.md
!/init.lua
!/settings.json
!/tests/
!/workspace/

# cargo: the development workspace build.
/workspace/target/
